{
    "editor.tabSize": 2,
    "editor.formatOnSave": true,
    "css.validate": false, // Desactiva el validador CSS por defecto de VS Code para evitar falsos positivos
    "editor.quickSuggestions": {
        "strings": "off"
    },
    "editor.codeActionsOnSave": {
      "source.fixAll.eslint": "explicit"
    },
    "[typescriptreact]": {
        "editor.tabSize": 2
    },
    "[typescript]": {
        "editor.tabSize": 2
    },
}